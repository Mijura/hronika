{
	"name": "hronika",
	"description": "Serverless API for project versioning",
	"version": "0.0.1",
	"private": true,
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.996.0",
		"@aws-sdk/lib-dynamodb": "^3.996.0",
		"@heksagon/app": "^0.0.14",
		"@heksagon/http": "^0.0.9",
		"@jigjoy-ai/auth": "^0.1.0",
		"@jigjoy-ai/file-artifacts": "^0.0.8",
		"@jigjoy-ai/serverless-core": "^0.0.5"
	},
	"devDependencies": {
		"@rstest/core": "^0.8.5",
		"@rstest/coverage-istanbul": "^0.2.1",
		"@types/aws-lambda": "^8.10.160",
		"@types/node": "^25.3.0",
		"@types/uuid": "^11.0.0",
		"dotenv": "^17.3.1",
		"esbuild": "^0.27.3",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.8.1",
		"swagger-ui-watcher": "^2.1.14",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"build:local": "sam build --profile spektrum-dev -t template.local.yaml ",
		"serve:local": "sam local start-api --profile spektrum-dev -t .aws-sam/build/template.yaml --host 0.0.0.0 --port 6000 --region eu-west-1 --env-vars env.json",
		"build:dev": "sam build --profile spektrum-dev",
		"deploy:dev": "sam deploy --profile spektrum-dev --capabilities CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND",
		"docs": "npx swagger-ui-watcher openapi.yaml --port 6060",
		"test": "rstest -c rstest.config.ts",
		"coverage": "rstest --coverage",
		"format": "prettier --write \"src/**/*.{ts,tsx}\""
	}
}
